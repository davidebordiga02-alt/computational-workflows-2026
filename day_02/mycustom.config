// ============================================================
// mycustom.config  —  nf-core/rnaseq custom configuration
// ============================================================

// --- Docker ---
docker.enabled = true

// --- Parametri booleani (senza virgolette!) ---
params {
    // Flag per saltare step non necessari (nome valido in nf-core/rnaseq 3.x)
    skip_stringtie    = true
    skip_bigwig       = true
    skip_markduplicates = true

    // Hard caps globali
    max_cpus   = 6
    max_memory = '12 GB'
    max_time   = '12h'
}

// --- Risorse di default per tutti i processi ---
process {
    cpus   = 2
    memory = '4 GB'
    time   = '4h'

    // --- GLOBAL SAFETY NET ---
    // Qualsiasi processo non esplicitamente elencato sotto è cappato qui.
    // Questo impedisce che processi come SAMTOOLS_SORT o PICARD_MARKDUPLICATES
    // chiedano 36 GB e facciano fallire la pipeline.
    maxRetries    = 2
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }

    // ---------- IL PROCESSO CHE HA FATTO FALLIRE LA PIPELINE ----------
    // Default di nf-core/rnaseq: 36 GB. Sul Mac da 16 GB lo cappiamo a 8 GB.
    withName: 'PICARD_MARKDUPLICATES' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    // ---------- Indicizzazione e allineamento ----------
    withName: 'HISAT2_EXTRACTSPLICESITES' {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }

    withName: 'HISAT2_BUILD' {
        cpus   = 6
        memory = '8 GB'
        time   = '12h'
    }

    withName: 'HISAT2_ALIGN' {
        cpus   = 6
        memory = '8 GB'
        time   = '8h'
    }

    withName: 'MAKE_TRANSCRIPTS_FASTA' {
        cpus   = 4
        memory = '6 GB'
        time   = '8h'
    }

    // ---------- SAMtools (default nf-core molto alti) ----------
    withName: 'SAMTOOLS_SORT' {
        cpus   = 4
        memory = '8 GB'
        time   = '8h'
    }

    withName: 'SAMTOOLS_INDEX'    { cpus = 2; memory = '4 GB'; time = '4h' }
    withName: 'SAMTOOLS_STATS'    { cpus = 2; memory = '4 GB'; time = '4h' }
    withName: 'SAMTOOLS_FLAGSTAT' { cpus = 2; memory = '4 GB'; time = '4h' }

    withName: 'BAM_SORT_STATS_SAMTOOLS' {
        cpus   = 4
        memory = '8 GB'
        time   = '8h'
    }

    // ---------- RSeQC (default nf-core: 36 GB) ----------
    withName: 'RSEQC_READDUPLICATION' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_GENEBODY_COVERAGE' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_INNER_DISTANCE' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_INNERDISTANCE' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_JUNCTION_ANNOTATION' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_JUNCTIONANNOTATION' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_JUNCTION_SATURATION' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_JUNCTIONSATURATION' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_READ_DISTRIBUTION' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_READDISTRIBUTION' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_RPKM_COUNT' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_BAMSTAT' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'RSEQC_INFEREXPERIMENT' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    // ---------- featureCounts / Subread ----------
    withName: 'SUBREAD_FEATURECOUNTS' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }

    // ---------- QualiMap ----------
    withName: 'QUALIMAP_RNASEQ' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }
}

// --- Report automatici ---
report   { overwrite = true }
timeline { overwrite = true }
trace    { overwrite = true }